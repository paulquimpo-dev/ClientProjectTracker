# Django
DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1

# PostgreSQL
DB_NAME=client_project_tracker
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgresql-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend origin permitted to call the API during local development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173

# Local development uses HTTP. Set to True only when the deployed application uses HTTPS.
DJANGO_COOKIE_SECURE=False
# Eight-hour maximum authenticated session; the cookie also expires when the browser closes.
DJANGO_SESSION_COOKIE_AGE=28800
